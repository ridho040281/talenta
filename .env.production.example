APP_NAME="TALENTA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://talenta.yourdomain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration (MySQL / MariaDB Production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=talenta_db
DB_USERNAME=talenta_user
DB_PASSWORD=YOUR_STRONG_PASSWORD_HERE

# Cache, Session, & Queue Drivers
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# Mail Configuration (SMTP Notification)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="panitia@talenta.test"
MAIL_FROM_NAME="${APP_NAME}"

# Wablas WhatsApp Gateway API
WABLAS_DOMAIN=https://kudus.wablas.com
WABLAS_API_TOKEN=